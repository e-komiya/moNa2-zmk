#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * Hardware-only diagnostic map for the right moNa2 matrix.
 * Every position is a plain key binding: no combos, layers, hold-taps,
 * pointing behavior, or Studio locking can hide a scan result.
 * The N position and following D3/P0.29 row positions are 1-5; the
 * immediately preceding edge position remains F12.
 */
/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P
                &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp SEMICOLON &kp ENTER
                &kp Z       &kp X       &kp C       &kp V       &kp B       &kp F12      &kp F12      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5
                &kp LEFT_SHIFT &kp DELETE &kp LEFT_ALT &kp SPACE &kp TAB &kp BACKSPACE &kp RIGHT_ALT &kp RIGHT_SHIFT &kp ESC
            >;
        };
    };
};
